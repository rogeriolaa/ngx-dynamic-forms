{
  "name": "ngx-dynamic-forms",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run build:libs >/dev/null 2>&1; ng serve demo",
    "build": "npm run build:libs && ng build demo",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "build:styles": "tailwindcss -i projects/core/theme/styles.source.css -o dist/core/styles.css --minify",
    "build:libs": "ng build core && ng build responder && ng build builder && ng build viewer && npm run build:styles && for lib in core responder builder viewer; do cp LICENSE dist/$lib/LICENSE; done",
    "lint": "ng lint"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@n0n3br/ngx-form-dependency-engine": "file:../form-dependency-engine/dist/ngx-form-dependency-engine",
    "idb": "^8.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.5",
    "@angular/cli": "^22.1.5",
    "@angular/compiler-cli": "^22.1.0",
    "@tailwindcss/cli": "^4.3.3",
    "fake-indexeddb": "^6.2.2",
    "jsdom": "^28.0.0",
    "ng-packagr": "^22.1.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
