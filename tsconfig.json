/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "compileOnSave": false,
  "compilerOptions": {
        "paths": {
      "@n0n3br/ngx-dynamic-forms-core": ["./dist/core"],
      "@n0n3br/ngx-dynamic-forms-builder": ["./dist/builder"],
      "@n0n3br/ngx-dynamic-forms-responder": ["./dist/responder"],
      "@n0n3br/ngx-dynamic-forms-viewer": ["./dist/viewer"],
      "builder": ["./dist/builder"],
      "core": ["./dist/core"],
      "responder": ["./dist/responder"],
      "viewer": ["./dist/viewer"]
    },
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve"
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  },
  "files": [],
  "references": [
    {
      "path": "./projects/core/tsconfig.lib.json"
    },
    {
      "path": "./projects/core/tsconfig.spec.json"
    },
    {
      "path": "./projects/builder/tsconfig.lib.json"
    },
    {
      "path": "./projects/builder/tsconfig.spec.json"
    },
    {
      "path": "./projects/responder/tsconfig.lib.json"
    },
    {
      "path": "./projects/responder/tsconfig.spec.json"
    },
    {
      "path": "./projects/viewer/tsconfig.lib.json"
    },
    {
      "path": "./projects/viewer/tsconfig.spec.json"
    },
    {
      "path": "./projects/demo/tsconfig.app.json"
    },
    {
      "path": "./projects/demo/tsconfig.spec.json"
    }
  ]
}
